---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Paw Paradise - Premium Cat Toys', description = 'Discover premium cat toys for happy, healthy cats' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="font-sans text-gray-900">
    <slot />
  </body>
</html>
