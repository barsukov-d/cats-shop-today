---
import Layout from '../layouts/Layout.astro';

const products = [
  { id: 1, name: 'Mouse Chase Toy', price: '$12.99', description: 'Interactive mouse-shaped toy' },
  { id: 2, name: 'Feather Wand', price: '$14.99', description: 'Colorful feather interactive toy' },
  { id: 3, name: 'Catnip Ball', price: '$8.99', description: 'Organic catnip filled toy' },
  { id: 4, name: 'Laser Pointer', price: '$10.99', description: 'Interactive laser play toy' },
];

const testimonials = [
  { id: 1, name: 'Sarah M.', rating: 5, text: 'My cat loves the feather wand! Best purchase ever.' },
  { id: 2, name: 'John D.', rating: 5, text: 'Quality toys that last. My cats play with them daily.' },
  { id: 3, name: 'Emma K.', rating: 5, text: 'Great customer service and fast shipping. Highly recommend!' },
];

const faqs = [
  { id: 1, question: 'Are the toys safe for kittens?', answer: 'Yes, all our toys are designed with safety in mind and are suitable for cats of all ages. They are made from non-toxic materials.' },
  { id: 2, question: 'Do you offer free shipping?', answer: 'Free shipping is available on orders over $50. Standard shipping typically takes 3-5 business days.' },
  { id: 3, question: 'What is your return policy?', answer: 'We offer a 30-day money-back guarantee if your cat doesn\'t love their toys.' },
  { id: 4, question: 'How often do you restock?', answer: 'We restock our products weekly to ensure availability of all popular items.' },
  { id: 5, question: 'Do you have bulk discounts?', answer: 'Yes! Contact our sales team for custom pricing on orders of 10 or more toys.' },
];
---

<Layout>
  <nav class="bg-white shadow-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
      <div class="flex items-center space-x-2">
        <span class="text-2xl">🐱</span>
        <h1 class="text-2xl font-bold text-primary-600">Paw Paradise</h1>
      </div>
      <div class="hidden md:flex space-x-6">
        <a href="#hero" class="text-gray-600 hover:text-primary-600 transition-colors">Home</a>
        <a href="#products" class="text-gray-600 hover:text-primary-600 transition-colors">Products</a>
        <a href="#testimonials" class="text-gray-600 hover:text-primary-600 transition-colors">Reviews</a>
        <a href="#about" class="text-gray-600 hover:text-primary-600 transition-colors">About</a>
        <a href="#faq" class="text-gray-600 hover:text-primary-600 transition-colors">FAQ</a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section id="hero" class="bg-gradient-to-r from-primary-50 to-primary-100 py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto text-center">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-primary-700 mb-6">
        Purr-fect Toys for Your Feline Friends
      </h2>
      <p class="text-lg md:text-xl text-gray-700 mb-8 max-w-2xl mx-auto">
        Premium, safe, and fun cat toys designed to keep your kitty entertained, active, and happy every single day.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <button class="btn-primary">Shop Now</button>
        <button class="btn-secondary">Learn More</button>
      </div>
    </div>
  </section>

  <!-- Featured Products Section -->
  <section id="products" class="py-20 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Featured Products</h2>
        <p class="text-lg text-gray-600">Handpicked toys that cats can't resist</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {products.map((product) => (
          <div class="bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
            <div class="bg-gradient-to-br from-primary-100 to-primary-50 h-48 flex items-center justify-center">
              <span class="text-6xl">🎾</span>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2">{product.name}</h3>
              <p class="text-gray-600 mb-4">{product.description}</p>
              <div class="flex justify-between items-center">
                <span class="text-2xl font-bold text-primary-600">{product.price}</span>
                <button class="bg-primary-600 text-white px-4 py-2 rounded-lg hover:bg-primary-700 transition-colors">
                  Add to Cart
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section id="testimonials" class="py-20 px-4 sm:px-6 lg:px-8 bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">What Cat Lovers Say</h2>
        <p class="text-lg text-gray-600">Real reviews from happy customers</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {testimonials.map((testimonial) => (
          <div class="bg-white rounded-lg shadow-md p-8">
            <div class="flex mb-4">
              {[...Array(testimonial.rating)].map((_, i) => (
                <span key={i} class="text-yellow-400 text-2xl">★</span>
              ))}
            </div>
            <p class="text-gray-700 mb-6 italic">"{testimonial.text}"</p>
            <p class="font-bold text-gray-900">— {testimonial.name}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Email Signup Section -->
  <section id="signup" class="py-20 px-4 sm:px-6 lg:px-8 bg-primary-600">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Stay Updated on New Toys</h2>
      <p class="text-primary-100 mb-8 text-lg">Get exclusive deals and product launches delivered to your inbox</p>

      <form id="emailForm" class="flex flex-col sm:flex-row gap-3">
        <input
          type="email"
          id="emailInput"
          placeholder="Enter your email"
          class="flex-1 px-6 py-3 rounded-lg text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary-300"
          required
        />
        <button
          type="submit"
          class="px-8 py-3 bg-white text-primary-600 font-bold rounded-lg hover:bg-gray-100 transition-colors whitespace-nowrap"
        >
          Subscribe
        </button>
      </form>

      <div id="successMessage" class="hidden mt-4 p-4 bg-green-100 text-green-800 rounded-lg">
        ✓ Thank you for subscribing!
      </div>
      <div id="errorMessage" class="hidden mt-4 p-4 bg-red-100 text-red-800 rounded-lg">
        Please enter a valid email address
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="py-20 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">About Paw Paradise</h2>
          <p class="text-lg text-gray-700 mb-4">
            Founded in 2015, Paw Paradise is dedicated to providing the highest quality cat toys that bring joy to felines everywhere. We believe every cat deserves toys that are safe, durable, and fun.
          </p>
          <p class="text-lg text-gray-700 mb-4">
            Our team of pet experts carefully selects and tests each product to ensure it meets our strict safety standards. We source only non-toxic materials and work with trusted manufacturers who share our commitment to animal welfare.
          </p>
          <p class="text-lg text-gray-700 mb-6">
            With over 50,000 happy cat owners served, we continue to innovate and bring exciting new toys to market. Join our community and discover why cats everywhere are purring with joy!
          </p>
          <div class="flex space-x-6">
            <div class="text-center">
              <p class="text-3xl font-bold text-primary-600">50K+</p>
              <p class="text-gray-600">Happy Cats</p>
            </div>
            <div class="text-center">
              <p class="text-3xl font-bold text-primary-600">10K+</p>
              <p class="text-gray-600">Reviews</p>
            </div>
            <div class="text-center">
              <p class="text-3xl font-bold text-primary-600">30</p>
              <p class="text-gray-600">Products</p>
            </div>
          </div>
        </div>
        <div class="bg-primary-100 rounded-lg h-96 flex items-center justify-center">
          <span class="text-9xl">😸</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="py-20 px-4 sm:px-6 lg:px-8 bg-gray-50">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Frequently Asked Questions</h2>
        <p class="text-lg text-gray-600">Find answers to common questions about our products</p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <button
              class="faq-toggle w-full px-6 py-4 flex justify-between items-center hover:bg-gray-50 transition-colors text-left"
              data-id={faq.id}
            >
              <span class="font-bold text-gray-900">{faq.question}</span>
              <span class="text-primary-600 font-bold text-xl">+</span>
            </button>
            <div class="faq-answer hidden px-6 py-4 border-t border-gray-200 bg-gray-50" data-id={faq.id}>
              <p class="text-gray-700">{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-900 text-white py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
        <div>
          <h3 class="text-lg font-bold mb-4">Paw Paradise</h3>
          <p class="text-gray-400">Premium cat toys for happy felines</p>
        </div>
        <div>
          <h4 class="font-bold mb-4">Quick Links</h4>
          <ul class="space-y-2 text-gray-400">
            <li><a href="#products" class="hover:text-white transition-colors">Products</a></li>
            <li><a href="#about" class="hover:text-white transition-colors">About</a></li>
            <li><a href="#faq" class="hover:text-white transition-colors">FAQ</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold mb-4">Support</h4>
          <ul class="space-y-2 text-gray-400">
            <li><a href="#" class="hover:text-white transition-colors">Contact Us</a></li>
            <li><a href="#" class="hover:text-white transition-colors">Shipping Info</a></li>
            <li><a href="#" class="hover:text-white transition-colors">Returns</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold mb-4">Follow Us</h4>
          <ul class="space-y-2 text-gray-400">
            <li><a href="#" class="hover:text-white transition-colors">Facebook</a></li>
            <li><a href="#" class="hover:text-white transition-colors">Instagram</a></li>
            <li><a href="#" class="hover:text-white transition-colors">Twitter</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-gray-800 pt-8 text-center text-gray-400">
        <p>&copy; 2024 Paw Paradise. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <script>
    // Email form handling
    const form = document.getElementById('emailForm');
    const emailInput = document.getElementById('emailInput');
    const successMessage = document.getElementById('successMessage');
    const errorMessage = document.getElementById('errorMessage');

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      successMessage.classList.add('hidden');
      errorMessage.classList.add('hidden');

      const email = emailInput.value.trim();
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      if (emailRegex.test(email)) {
        successMessage.classList.remove('hidden');
        emailInput.value = '';
      } else {
        errorMessage.classList.remove('hidden');
      }
    });

    // FAQ accordion handling
    document.querySelectorAll('.faq-toggle').forEach((button) => {
      button.addEventListener('click', () => {
        const id = button.getAttribute('data-id');
        const answer = document.querySelector(`.faq-answer[data-id="${id}"]`);
        const isHidden = answer.classList.contains('hidden');

        document.querySelectorAll('.faq-answer').forEach((a) => a.classList.add('hidden'));
        document.querySelectorAll('.faq-toggle span:last-child').forEach((span) => (span.textContent = '+'));

        if (isHidden) {
          answer.classList.remove('hidden');
          button.querySelector('span:last-child').textContent = '−';
        }
      });
    });
  </script>
</Layout>
